# BridgeWise - placeholders only. Never commit a real .env.
# See docs/MASTER_PLAYBOOK.md section 15.2.

APP_ENV=local_demo                 # local_demo | test | hosted_demo
EXECUTION_MODE=SIMULATED           # SIMULATED only; LIVE is not implemented

DATABASE_URL=postgresql://bridgewise:CHANGE_ME@localhost:5432/bridgewise
TEST_DATABASE_URL=postgresql://bridgewise:CHANGE_ME@localhost:5432/bridgewise_test

SESSION_SECRET=generate_32_bytes_of_random_hex

MODEL_PROVIDER=anthropic
MODEL_NAME=claude-haiku-5-5            # leave MODEL_API_KEY empty for the guided planner
MODEL_API_KEY=                     # server-only; absent from any client bundle

EXECUTION_ENABLED=true             # kill switch, checked at approval and dispatch
ALLOWED_ORIGINS=http://localhost:3000
MAX_RUN_STEPS=6
MAX_RUN_TOKENS=512
DEMO_RETENTION_HOURS=24
SESSION_RATE_LIMIT_PER_MINUTE=20   # raise for the browser suite, which creates many workspaces

# Payments (optional; each rail is hidden until its keys are set). See docs/DEPLOY.md.
# Alipay open platform: sandbox app from https://open.alipay.com/develop/sandbox/app
ALIPAY_APP_ID=
ALIPAY_PUBLIC_KEY=                 # the Alipay public key shown after you upload yours
ALIPAY_PRIVATE_KEY=                # or put the PEM at secrets/alipay_app_private.pem (gitignored)
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Alipay sandbox buyer used by the tests that move sandbox money (from the sandbox accounts page)
# ALIPAY_SANDBOX_PAYEE=
# ALIPAY_SANDBOX_PAYEE_NAME=
# Stripe test mode
STRIPE_SECRET_KEY=                 # sk_test_...
STRIPE_PUBLISHABLE_KEY=            # pk_test_...
